# Agrim backend configuration. Copy to `.env`.
# Every USE_LIVE_* flag defaults to false: with none set the system runs fully
# on synthetic data with zero external network calls (and says so in the UI).

# ── Live data sources ────────────────────────────────────────────────────────
USE_LIVE_RADAR=false        # RainViewer (IMD radar network) — no key
USE_LIVE_LIGHTNING=false    # Blitzortung.org VLF strikes — no key
USE_LIVE_ECMWF=false        # ECMWF Open Data 0.25 deg HRES — no key
USE_LIVE_IMD=false          # Tomorrow.io station weather (needs key below)
USE_LIVE_SATELLITE=false    # Copernicus Sentinel-3 SLSTR (needs credentials below)

TOMORROW_API_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# ── SMS alerts (optional) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBERS=           # comma-separated, e.g. +919XXXXXXXXX,+918XXXXXXXXX
ALERT_MIN_SEVERITY=high     # low | moderate | high
ALERT_COOLDOWN_MINUTES=60
